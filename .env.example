# Lesson Quiz Generator Environment Configuration
APP_ENV=development
MOCK_LLM=true

# Database configuration
DATABASE_URL=sqlite:///./quizzes.db

# LLM Provider ("gemini", "openai", or "groq")
LLM_PROVIDER=gemini

# Optional: Add your API keys below if setting MOCK_LLM=false
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000

